        </mxCell>

        <mxCell id="gateway" value="API Gateway&#10;FastAPI :8000&#10;auth, REST API, orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
